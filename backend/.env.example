# ==========================================
# PeerLoop - Backend Environment Variables
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/peerloop
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/peerloop
MONGO_URI=mongodb://127.0.0.1:27017/peerloop

# JWT Secret for session authentication (Auto-generated if using 'npm run setup')
JWT_SECRET=your_jwt_secret_key_here

# Pinata IPFS Credentials (Get from https://app.pinata.cloud/developers/api-keys)
# You can use PINATA_JWT or both PINATA_API_KEY + PINATA_API_SECRET
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# Ethereum Sepolia RPC URL (Get from Alchemy https://dashboard.alchemy.com/ or Infura)
# Note: Used by contract listener and exposed read-only to client via /api/config/rpc-url
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# Deployed Marketplace Contract Address
# (Automatically filled when running smart contract deployment script)
CONTRACT_ADDRESS=0x8693297bD80A12b91d7d890A7d469FCb02E2574D
