# ==========================================
# PeerLoop - Combined Environment Variables Template
# ==========================================

# --- Backend Config ---
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/peerloop
JWT_SECRET=your_jwt_secret_key_here

# Pinata IPFS Credentials (Get from https://app.pinata.cloud/developers/api-keys)
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# --- Blockchain Config ---
# Ethereum Sepolia RPC URL (Get from Alchemy https://dashboard.alchemy.com/ or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
# Optional WebSocket override. If blank, the app derives wss:// from SEPOLIA_RPC_URL.
# Use your provider's WebSocket URL if it differs; HTTP polling remains the fallback.
SEPOLIA_WSS_URL=

# Deployed Marketplace Contract Address (Automatically filled on deployment)
CONTRACT_ADDRESS=


# Deployer Wallet Private Key (Export from MetaMask: Account Details -> Show Private Key)
PRIVATE_KEY=your_private_key_here
APP_ORIGIN=http://localhost:3000
# In production, set API_ORIGIN when the API is served on a different host from APP_ORIGIN.
# Set TRUST_PROXY to the exact hop count or trusted proxy IPs/subnets for your deployment.
API_ORIGIN=
TRUST_PROXY=
