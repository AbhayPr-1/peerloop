{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-unused-expressions": "off",
    "unicorn/no-new-array": "off"
  },
  "env": {
    "builtin": true
  }
}