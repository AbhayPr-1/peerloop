# Ethereum Sepolia RPC URL (From Alchemy: https://dashboard.alchemy.com/ or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# Deployer Wallet Private Key (Export from MetaMask: Account Details -> Show Private Key)
# CAUTION: NEVER commit real private keys or use accounts with real mainnet funds!
PRIVATE_KEY=your_private_key_here
