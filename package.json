{
  "name": "peerloop-backend",
  "version": "1.0.0",
  "description": "Backend server for the PeerLoop application",
  "main": "server.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon ./backend/server.js",
    "dev:frontend": "serve frontend -l 3000",
    "start": "node ./backend/server.js",
    "contracts:compile": "npm run --prefix smart-contract compile",
    "contracts:deploy": "npm run --prefix smart-contract deploy",
    "contracts:deploy:local": "npm run --prefix smart-contract deploy:local"
  },
  "dependencies": {
    "@pinata/sdk": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.22.3",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.11",
    "serve": "^14.2.6"
  },
  "overrides": {
    "axios": "^1.21.0",
    "compression": "^1.8.2",
    "form-data": "^2.5.6"
  }
}
